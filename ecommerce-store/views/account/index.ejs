<%- include('../partials/header') %>

<section class="section">
  <div class="container">
    <div class="account-layout">
      <aside class="account-sidebar">
        <div class="account-user">
          <div class="account-avatar"><%= profile.name.charAt(0).toUpperCase() %></div>
          <h3><%= profile.name %></h3>
          <p><%= profile.email %></p>
        </div>
        <nav class="account-nav">
          <a href="/account" class="account-nav__link is-active">My Orders</a>
          <a href="#" class="account-nav__link">Wishlist</a>
          <a href="/auth/logout" class="account-nav__link">Logout</a>
        </nav>
      </aside>
      <div class="account-content">
        <h1>My Orders</h1>
        <% if (orders.length === 0) { %>
          <div class="empty-state">
            <div class="empty-state__icon">
              <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="var(--gray-300)" stroke-width="1.5"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            </div>
            <h3>No orders yet</h3>
            <p>Start shopping to see your orders here.</p>
            <a href="/products" class="btn btn--primary">Browse Products</a>
          </div>
        <% } else { %>
          <div class="orders-list">
            <% orders.forEach(order => { %>
              <div class="order-card">
                <div class="order-card__header">
                  <div>
                    <span class="order-card__number">#<%= order.orderNumber || order._id.toString().slice(-8).toUpperCase() %></span>
                    <span class="order-card__date"><%= order.createdAt.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></span>
                  </div>
                  <span class="badge badge--<%= order.status %>"><%= order.status.replace('_', ' ') %></span>
                </div>
                <div class="order-card__items">
                  <% order.items.slice(0, 3).forEach(item => { %>
                    <div class="order-card__item">
                      <img src="<%= item.image %>" alt="<%= item.name %>" class="order-card__img">
                      <div>
                        <p class="order-card__name"><%= item.name %></p>
                        <p class="order-card__qty">Qty: <%= item.quantity %></p>
                      </div>
                    </div>
                  <% }) %>
                  <% if (order.items.length > 3) { %>
                    <p class="order-card__more">+<%= order.items.length - 3 %> more items</p>
                  <% } %>
                </div>
                <div class="order-card__footer">
                  <span class="order-card__total">Total: <strong>$<%= order.totalAmount.toFixed(2) %></strong></span>
                  <a href="/orders/<%= order._id %>" class="btn btn--secondary btn--sm">View Details</a>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
