<% var user = typeof user !== 'undefined' ? user : null; %>
<% var cartCount = typeof cartCount !== 'undefined' ? cartCount : 0; %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' | ' : '' %>ShopEase</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="announcement-bar" id="announcementBar">
    <span>Free shipping on orders over $50 &nbsp;|&nbsp; Use code <strong>WELCOME10</strong> for 10% off</span>
    <button class="announcement-bar__close" onclick="this.parentElement.style.display='none';localStorage.setItem('announceHidden','1');" aria-label="Close">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>

  <nav class="navbar" id="navbar">
    <div class="container navbar__inner">
      <a href="/" class="navbar__logo"><span class="navbar__logo-text">Shop<em>Ease</em></span></a>

      <div class="navbar__nav">
        <a href="/">Home</a>
        <a href="/products">Shop</a>
        <a href="/products?featured=true">Deals</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
      </div>

      <div class="navbar__actions">
        <div class="navbar__search">
          <form action="/products" method="GET">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" name="search" placeholder="Search products...">
          </form>
        </div>
        <a href="/cart" class="navbar__icon-btn">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
          <% if (cartCount > 0) { %><span class="navbar__cart-count"><%= cartCount %></span><% } %>
        </a>
        <div class="navbar__auth">
          <% if (user) { %>
            <a href="/account" class="btn btn-ghost btn-sm">My Account</a>
            <% if (user.role === 'admin') { %><a href="/admin" class="btn btn-ghost btn-sm">Dashboard</a><% } %>
            <a href="/auth/logout" class="btn btn-secondary btn-sm">Logout</a>
          <% } else { %>
            <a href="/auth/login" class="btn btn-ghost btn-sm">Login</a>
            <a href="/auth/register" class="btn btn-primary btn-sm">Sign Up</a>
          <% } %>
        </div>
        <button id="hamburgerMenu" class="navbar__hamburger" aria-label="Menu">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </nav>

  <div id="mobileNav" class="mobile-nav">
    <a href="/">Home</a>
    <a href="/products">Shop</a>
    <a href="/products?featured=true">Deals</a>
    <a href="/about">About</a>
    <a href="/contact">Contact</a>
    <a href="/cart">Cart (<%= cartCount %>)</a>
    <% if (user) { %>
      <a href="/account">My Account</a>
      <% if (user.role === 'admin') { %><a href="/admin">Dashboard</a><% } %>
      <a href="/auth/logout">Logout</a>
    <% } else { %>
      <a href="/auth/login">Login</a>
      <a href="/auth/register">Sign Up</a>
    <% } %>
  </div>

  <main>
