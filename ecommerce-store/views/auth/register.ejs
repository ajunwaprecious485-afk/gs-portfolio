<%- include('../partials/header') %>

<!-- ======================== REGISTER PAGE ======================== -->
<section style="min-height: calc(100vh - var(--navbar-height) - var(--announcement-height)); display: flex;">
  <div style="display: grid; grid-template-columns: 1fr 1fr; width: 100%;">

    <!-- Left Side: Branding / Illustration -->
    <div style="position: relative; background: linear-gradient(135deg, var(--color-dark) 0%, var(--color-dark-lighter) 100%); display: flex; align-items: center; justify-content: center; padding: var(--space-12); overflow: hidden;">
      <div style="position: absolute; inset: 0; background-image: url('https://images.unsplash.com/photo-1441986300917-64674bd600d8?w=1200&h=900&fit=crop'); background-size: cover; background-position: center; opacity: 0.1;"></div>
      <div style="position: relative; z-index: 1; text-align: center; max-width: 400px;">
        <a href="/" style="display: inline-block; margin-bottom: var(--space-8);">
          <span style="font-size: var(--text-4xl); font-weight: var(--font-extrabold); color: var(--color-white);">Shop<em style="color: var(--color-primary-light); font-style: normal;">Ease</em></span>
        </a>
        <h2 style="font-size: var(--text-2xl); font-weight: var(--font-bold); color: var(--color-white); margin-bottom: var(--space-4);">Join ShopEase Today</h2>
        <p style="font-size: var(--text-base); color: rgba(255,255,255,0.7); line-height: var(--leading-relaxed);">Create an account to enjoy exclusive deals, track orders, and build your wishlist.</p>

        <!-- Perks -->
        <div style="display: flex; flex-direction: column; gap: var(--space-4); margin-top: var(--space-10);">
          <div style="display: flex; align-items: center; gap: var(--space-3); text-align: left;">
            <div style="width: 40px; height: 40px; background: rgba(255,255,255,0.1); border-radius: var(--radius-lg); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary-light)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <span style="font-size: var(--text-sm); color: rgba(255,255,255,0.8);">10% off your first order with code WELCOME10</span>
          </div>
          <div style="display: flex; align-items: center; gap: var(--space-3); text-align: left;">
            <div style="width: 40px; height: 40px; background: rgba(255,255,255,0.1); border-radius: var(--radius-lg); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary-light)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            </div>
            <span style="font-size: var(--text-sm); color: rgba(255,255,255,0.8);">Save favorite items to your wishlist</span>
          </div>
          <div style="display: flex; align-items: center; gap: var(--space-3); text-align: left;">
            <div style="width: 40px; height: 40px; background: rgba(255,255,255,0.1); border-radius: var(--radius-lg); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary-light)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            </div>
            <span style="font-size: var(--text-sm); color: rgba(255,255,255,0.8);">Fast & free shipping on orders over $50</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Side: Register Form -->
    <div style="display: flex; align-items: center; justify-content: center; padding: var(--space-12); background: var(--color-white);">
      <div style="width: 100%; max-width: 420px;">
        <h1 style="font-size: var(--text-3xl); font-weight: var(--font-bold); color: var(--color-dark); margin-bottom: var(--space-2);">Create Account</h1>
        <p style="font-size: var(--text-base); color: var(--color-gray-500); margin-bottom: var(--space-8);">Fill in the details below to get started.</p>

        <!-- Error Alert -->
        <% if (typeof error !== 'undefined' && error) { %>
          <div style="display: flex; align-items: center; gap: var(--space-3); padding: var(--space-4); background: var(--color-error-light); border: 1px solid #fecaca; border-radius: var(--radius-lg); margin-bottom: var(--space-6);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-error)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
            <span style="font-size: var(--text-sm); color: #991b1b; font-weight: var(--font-medium);"><%= error %></span>
          </div>
        <% } %>

        <form action="/auth/register" method="POST">
          <div class="form-group">
            <label class="form-label">Full Name <span class="required">*</span></label>
            <div class="input-icon-wrapper">
              <span class="input-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              </span>
              <input type="text" name="fullName" class="form-input" placeholder="John Doe" required>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Email Address <span class="required">*</span></label>
            <div class="input-icon-wrapper">
              <span class="input-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </span>
              <input type="email" name="email" class="form-input" placeholder="you@example.com" required>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Password <span class="required">*</span></label>
            <div class="input-icon-wrapper">
              <span class="input-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              </span>
              <input type="password" name="password" class="form-input" placeholder="Min. 8 characters" required minlength="8">
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Confirm Password <span class="required">*</span></label>
            <div class="input-icon-wrapper">
              <span class="input-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              </span>
              <input type="password" name="confirmPassword" class="form-input" placeholder="Re-enter your password" required minlength="8">
            </div>
          </div>

          <div style="margin-bottom: var(--space-6);">
            <label class="form-checkbox" style="margin: 0; min-height: auto;">
              <input type="checkbox" name="terms" required style="width: 16px; height: 16px;">
              <span style="font-size: var(--text-sm); color: var(--color-gray-600);">I agree to the <a href="#" style="font-weight: var(--font-semibold); color: var(--color-primary);">Terms & Conditions</a></span>
            </label>
          </div>

          <button type="submit" class="btn btn-primary btn-block btn-lg" style="margin-bottom: var(--space-6);">
            Create Account
          </button>

          <p style="text-align: center; font-size: var(--text-sm); color: var(--color-gray-500);">
            Already have an account? <a href="/auth/login" style="font-weight: var(--font-semibold); color: var(--color-primary); transition: color 0.15s ease;" onmouseover="this.style.color='var(--color-primary-dark)'" onmouseout="this.style.color='var(--color-primary)'">Sign in</a>
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
