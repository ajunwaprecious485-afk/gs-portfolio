<%- include('../partials/header') %>

<!-- ======================== BREADCRUMBS ======================== -->
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <div class="container">
    <ol class="breadcrumbs__list">
      <li class="breadcrumbs__item">
        <a href="/" class="breadcrumbs__link">Home</a>
        <span class="breadcrumbs__separator">/</span>
      </li>
      <li class="breadcrumbs__item">
        <a href="/cart" class="breadcrumbs__link">Cart</a>
        <span class="breadcrumbs__separator">/</span>
      </li>
      <li class="breadcrumbs__item">
        <span class="breadcrumbs__current">Checkout</span>
      </li>
    </ol>
  </div>
</nav>

<!-- ======================== CHECKOUT PAGE ======================== -->
<section class="products-section" style="padding-top: var(--space-8); padding-bottom: var(--space-16);">
  <div class="container">
    <h1 style="font-size: var(--text-3xl); font-weight: var(--font-bold); color: var(--color-dark); margin-bottom: var(--space-8);">Checkout</h1>

    <!-- ======================== PROGRESS INDICATOR ======================== -->
    <div style="display: flex; align-items: center; justify-content: center; gap: 0; margin-bottom: var(--space-10); max-width: 600px; margin-left: auto; margin-right: auto;">
      <!-- Step 1 -->
      <div class="checkout-step-indicator active" data-step="1" style="display: flex; align-items: center; gap: var(--space-2); cursor: pointer;" onclick="goToStep(1)">
        <div style="width: 36px; height: 36px; border-radius: var(--radius-full); background: var(--color-primary); color: var(--color-white); display: flex; align-items: center; justify-content: center; font-size: var(--text-sm); font-weight: var(--font-bold); flex-shrink: 0;">1</div>
        <span style="font-size: var(--text-sm); font-weight: var(--font-semibold); color: var(--color-primary); white-space: nowrap;">Shipping</span>
      </div>
      <div style="flex: 1; height: 2px; background: var(--color-gray-200); margin: 0 var(--space-3); position: relative;">
        <div id="progress-1-2" style="position: absolute; inset: 0; background: var(--color-primary); transform: scaleX(0); transform-origin: left; transition: transform 0.4s ease;"></div>
      </div>
      <!-- Step 2 -->
      <div class="checkout-step-indicator" data-step="2" style="display: flex; align-items: center; gap: var(--space-2); cursor: pointer;" onclick="goToStep(2)">
        <div style="width: 36px; height: 36px; border-radius: var(--radius-full); background: var(--color-gray-200); color: var(--color-gray-500); display: flex; align-items: center; justify-content: center; font-size: var(--text-sm); font-weight: var(--font-bold); flex-shrink: 0; transition: all 0.3s ease;">2</div>
        <span style="font-size: var(--text-sm); font-weight: var(--font-semibold); color: var(--color-gray-400); white-space: nowrap; transition: color 0.3s ease;">Payment</span>
      </div>
      <div style="flex: 1; height: 2px; background: var(--color-gray-200); margin: 0 var(--space-3); position: relative;">
        <div id="progress-2-3" style="position: absolute; inset: 0; background: var(--color-primary); transform: scaleX(0); transform-origin: left; transition: transform 0.4s ease;"></div>
      </div>
      <!-- Step 3 -->
      <div class="checkout-step-indicator" data-step="3" style="display: flex; align-items: center; gap: var(--space-2); cursor: pointer;" onclick="goToStep(3)">
        <div style="width: 36px; height: 36px; border-radius: var(--radius-full); background: var(--color-gray-200); color: var(--color-gray-500); display: flex; align-items: center; justify-content: center; font-size: var(--text-sm); font-weight: var(--font-bold); flex-shrink: 0; transition: all 0.3s ease;">3</div>
        <span style="font-size: var(--text-sm); font-weight: var(--font-semibold); color: var(--color-gray-400); white-space: nowrap; transition: color 0.3s ease;">Review</span>
      </div>
    </div>

    <form action="/checkout/place-order" method="POST" id="checkoutForm">
      <div style="display: grid; grid-template-columns: 1fr 380px; gap: var(--space-8); align-items: start;">

        <!-- ======================== MAIN CONTENT (LEFT) ======================== -->
        <div>

          <!-- ===== STEP 1: SHIPPING ===== -->
          <div class="checkout-panel active" id="panel-1">
            <div class="card" style="padding: var(--space-8);">
              <div style="display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-6);">
                <div style="width: 40px; height: 40px; background: var(--color-primary-50); border-radius: var(--radius-lg); display: flex; align-items: center; justify-content: center;">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                </div>
                <h2 style="font-size: var(--text-xl); font-weight: var(--font-bold); color: var(--color-dark);">Shipping Information</h2>
              </div>

              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4);">
                <div class="form-group" style="grid-column: 1 / -1;">
                  <label class="form-label">Full Name <span class="required">*</span></label>
                  <input type="text" name="fullName" class="form-input" placeholder="John Doe" required>
                </div>
                <div class="form-group" style="grid-column: 1 / -1;">
                  <label class="form-label">Street Address <span class="required">*</span></label>
                  <input type="text" name="street" class="form-input" placeholder="123 Main Street, Apt 4B" required>
                </div>
                <div class="form-group">
                  <label class="form-label">City <span class="required">*</span></label>
                  <input type="text" name="city" class="form-input" placeholder="New York" required>
                </div>
                <div class="form-group">
                  <label class="form-label">State <span class="required">*</span></label>
                  <input type="text" name="state" class="form-input" placeholder="NY" required>
                </div>
                <div class="form-group">
                  <label class="form-label">ZIP Code <span class="required">*</span></label>
                  <input type="text" name="zip" class="form-input" placeholder="10001" required>
                </div>
                <div class="form-group">
                  <label class="form-label">Country <span class="required">*</span></label>
                  <select name="country" class="form-select" required>
                    <option value="">Select country</option>
                    <option value="US" selected>United States</option>
                    <option value="CA">Canada</option>
                    <option value="UK">United Kingdom</option>
                    <option value="AU">Australia</option>
                    <option value="NG">Nigeria</option>
                  </select>
                </div>
              </div>

              <div style="display: flex; justify-content: flex-end; margin-top: var(--space-6);">
                <button type="button" class="btn btn-primary btn-lg" onclick="goToStep(2)">
                  Continue to Payment
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </button>
              </div>
            </div>
          </div>

          <!-- ===== STEP 2: PAYMENT ===== -->
          <div class="checkout-panel" id="panel-2" style="display: none;">
            <div class="card" style="padding: var(--space-8);">
              <div style="display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-6);">
                <div style="width: 40px; height: 40px; background: var(--color-primary-50); border-radius: var(--radius-lg); display: flex; align-items: center; justify-content: center;">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                </div>
                <h2 style="font-size: var(--text-xl); font-weight: var(--font-bold); color: var(--color-dark);">Payment Method</h2>
              </div>

              <!-- Cash on Delivery Option -->
              <div style="border: 2px solid var(--color-primary); border-radius: var(--radius-xl); padding: var(--space-6); background: var(--color-primary-50); cursor: pointer;" id="codOption">
                <div style="display: flex; align-items: center; gap: var(--space-4);">
                  <div style="width: 48px; height: 48px; background: var(--color-primary); border-radius: var(--radius-lg); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                  </div>
                  <div style="flex: 1;">
                    <h4 style="font-size: var(--text-base); font-weight: var(--font-semibold); color: var(--color-dark); margin-bottom: var(--space-1);">Cash on Delivery</h4>
                    <p style="font-size: var(--text-sm); color: var(--color-gray-500); margin: 0;">Pay when your order arrives at your doorstep.</p>
                  </div>
                  <div style="width: 22px; height: 22px; border: 2px solid var(--color-primary); border-radius: var(--radius-full); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                    <div style="width: 12px; height: 12px; background: var(--color-primary); border-radius: var(--radius-full);"></div>
                  </div>
                </div>
              </div>

              <input type="hidden" name="paymentMethod" value="cod">

              <div style="display: flex; justify-content: space-between; margin-top: var(--space-6);">
                <button type="button" class="btn btn-ghost btn-lg" onclick="goToStep(1)">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                  Back
                </button>
                <button type="button" class="btn btn-primary btn-lg" onclick="goToStep(3)">
                  Review Order
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </button>
              </div>
            </div>
          </div>

          <!-- ===== STEP 3: REVIEW ===== -->
          <div class="checkout-panel" id="panel-3" style="display: none;">
            <div class="card" style="padding: var(--space-8);">
              <div style="display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-6);">
                <div style="width: 40px; height: 40px; background: var(--color-primary-50); border-radius: var(--radius-lg); display: flex; align-items: center; justify-content: center;">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                </div>
                <h2 style="font-size: var(--text-xl); font-weight: var(--font-bold); color: var(--color-dark);">Order Review</h2>
              </div>

              <!-- Order Items -->
              <div style="margin-bottom: var(--space-6);">
                <h4 style="font-size: var(--text-sm); font-weight: var(--font-semibold); color: var(--color-gray-500); text-transform: uppercase; letter-spacing: var(--tracking-wider); margin-bottom: var(--space-4);">Items (<%= cart.length %>)</h4>
                <div style="display: flex; flex-direction: column; gap: var(--space-4);">
                  <% cart.forEach(function(item) { %>
                    <div style="display: flex; gap: var(--space-4); align-items: center; padding: var(--space-3); background: var(--color-gray-50); border-radius: var(--radius-lg);">
                      <img src="<%= item.image %>" alt="<%= item.name %>" style="width: 64px; height: 64px; object-fit: cover; border-radius: var(--radius-md); border: 1px solid var(--color-gray-200); flex-shrink: 0;">
                      <div style="flex: 1; min-width: 0;">
                        <p style="font-size: var(--text-sm); font-weight: var(--font-medium); color: var(--color-dark); margin-bottom: var(--space-1); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= item.name %></p>
                        <p style="font-size: var(--text-xs); color: var(--color-gray-500); margin: 0;">Qty: <%= item.quantity %> &times; $<%= item.price.toFixed(2) %></p>
                      </div>
                      <span style="font-size: var(--text-sm); font-weight: var(--font-semibold); color: var(--color-dark); white-space: nowrap;">$<%= (item.price * item.quantity).toFixed(2) %></span>
                    </div>
                  <% }); %>
                </div>
              </div>

              <!-- Summary -->
              <div style="background: var(--color-gray-50); border-radius: var(--radius-lg); padding: var(--space-5); margin-bottom: var(--space-6);">
                <div style="display: flex; justify-content: space-between; margin-bottom: var(--space-2);">
                  <span style="font-size: var(--text-sm); color: var(--color-gray-600);">Subtotal</span>
                  <span style="font-size: var(--text-sm); font-weight: var(--font-semibold);">$<%= subtotal.toFixed(2) %></span>
                </div>
                <div style="display: flex; justify-content: space-between; margin-bottom: var(--space-2);">
                  <span style="font-size: var(--text-sm); color: var(--color-gray-600);">Shipping</span>
                  <span style="font-size: var(--text-sm); font-weight: var(--font-semibold); color: <%= shipping === 0 ? 'var(--color-success)' : 'var(--color-dark)' %>;"><%= shipping === 0 ? 'Free' : '$' + shipping.toFixed(2) %></span>
                </div>
                <div style="display: flex; justify-content: space-between; padding-top: var(--space-3); border-top: 1.5px solid var(--color-gray-200); margin-top: var(--space-3);">
                  <span style="font-size: var(--text-lg); font-weight: var(--font-bold); color: var(--color-dark);">Total</span>
                  <span style="font-size: var(--text-xl); font-weight: var(--font-extrabold); color: var(--color-dark);">$<%= total.toFixed(2) %></span>
                </div>
              </div>

              <!-- Payment Method Display -->
              <div style="display: flex; align-items: center; gap: var(--space-3); padding: var(--space-4); background: var(--color-gray-50); border-radius: var(--radius-lg); margin-bottom: var(--space-6);">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                <span style="font-size: var(--text-sm); font-weight: var(--font-medium); color: var(--color-dark);">Payment: Cash on Delivery</span>
              </div>

              <div style="display: flex; justify-content: space-between; margin-top: var(--space-6);">
                <button type="button" class="btn btn-ghost btn-lg" onclick="goToStep(2)">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                  Back
                </button>
                <button type="submit" class="btn btn-primary btn-lg">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                  Place Order &mdash; $<%= total.toFixed(2) %>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- ======================== SIDEBAR ORDER SUMMARY ======================== -->
        <div style="position: sticky; top: calc(var(--navbar-height) + var(--space-6));">
          <div class="card" style="padding: var(--space-6);">
            <h3 style="font-size: var(--text-lg); font-weight: var(--font-bold); color: var(--color-dark); margin-bottom: var(--space-5); padding-bottom: var(--space-4); border-bottom: 1px solid var(--color-gray-200);">Order Summary</h3>

            <!-- Items List -->
            <div style="display: flex; flex-direction: column; gap: var(--space-3); margin-bottom: var(--space-5); max-height: 240px; overflow-y: auto;">
              <% cart.forEach(function(item) { %>
                <div style="display: flex; gap: var(--space-3); align-items: center;">
                  <div style="position: relative; flex-shrink: 0;">
                    <img src="<%= item.image %>" alt="<%= item.name %>" style="width: 52px; height: 52px; object-fit: cover; border-radius: var(--radius-md); border: 1px solid var(--color-gray-200);">
                    <span style="position: absolute; top: -6px; right: -6px; width: 20px; height: 20px; background: var(--color-gray-600); color: var(--color-white); border-radius: var(--radius-full); display: flex; align-items: center; justify-content: center; font-size: 10px; font-weight: var(--font-bold);"><%= item.quantity %></span>
                  </div>
                  <div style="flex: 1; min-width: 0;">
                    <p style="font-size: var(--text-sm); font-weight: var(--font-medium); color: var(--color-dark); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-bottom: 2px;"><%= item.name %></p>
                    <p style="font-size: var(--text-xs); color: var(--color-gray-500); margin: 0;">$<%= item.price.toFixed(2) %> each</p>
                  </div>
                  <span style="font-size: var(--text-sm); font-weight: var(--font-semibold); color: var(--color-dark);">$<%= (item.price * item.quantity).toFixed(2) %></span>
                </div>
              <% }); %>
            </div>

            <div style="border-top: 1px solid var(--color-gray-200); padding-top: var(--space-4); display: flex; flex-direction: column; gap: var(--space-2); margin-bottom: var(--space-4);">
              <div style="display: flex; justify-content: space-between;">
                <span style="font-size: var(--text-sm); color: var(--color-gray-600);">Subtotal</span>
                <span style="font-size: var(--text-sm); font-weight: var(--font-semibold);">$<%= subtotal.toFixed(2) %></span>
              </div>
              <div style="display: flex; justify-content: space-between;">
                <span style="font-size: var(--text-sm); color: var(--color-gray-600);">Shipping</span>
                <span style="font-size: var(--text-sm); font-weight: var(--font-semibold); color: <%= shipping === 0 ? 'var(--color-success)' : '' %>;"><%= shipping === 0 ? 'Free' : '$' + shipping.toFixed(2) %></span>
              </div>
            </div>

            <div style="display: flex; justify-content: space-between; padding-top: var(--space-4); border-top: 1.5px solid var(--color-gray-200);">
              <span style="font-size: var(--text-base); font-weight: var(--font-bold); color: var(--color-dark);">Total</span>
              <span style="font-size: var(--text-xl); font-weight: var(--font-extrabold); color: var(--color-dark);">$<%= total.toFixed(2) %></span>
            </div>

            <!-- Trust Badges -->
            <div style="margin-top: var(--space-5); padding-top: var(--space-4); border-top: 1px solid var(--color-gray-200);">
              <div style="display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-3);">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-success)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                <span style="font-size: var(--text-xs); color: var(--color-gray-500);">Secure 256-bit SSL encryption</span>
              </div>
              <div style="display: flex; align-items: center; gap: var(--space-3);">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-success)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                <span style="font-size: var(--text-xs); color: var(--color-gray-500);">30-day money-back guarantee</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>
</section>

<script>
var currentStep = 1;

function goToStep(step) {
  currentStep = step;

  // Update step panels
  document.querySelectorAll('.checkout-panel').forEach(function(panel) {
    panel.style.display = 'none';
    panel.classList.remove('active');
  });
  var activePanel = document.getElementById('panel-' + step);
  if (activePanel) {
    activePanel.style.display = 'block';
    activePanel.classList.add('active');
  }

  // Update step indicators
  document.querySelectorAll('.checkout-step-indicator').forEach(function(indicator) {
    var indicatorStep = parseInt(indicator.getAttribute('data-step'));
    var circle = indicator.querySelector('div');
    var label = indicator.querySelector('span');

    if (indicatorStep <= step) {
      circle.style.background = 'var(--color-primary)';
      circle.style.color = 'var(--color-white)';
      label.style.color = 'var(--color-primary)';
    } else {
      circle.style.background = 'var(--color-gray-200)';
      circle.style.color = 'var(--color-gray-500)';
      label.style.color = 'var(--color-gray-400)';
    }
  });

  // Update progress bars
  var bar12 = document.getElementById('progress-1-2');
  var bar23 = document.getElementById('progress-2-3');
  if (bar12) bar12.style.transform = step >= 2 ? 'scaleX(1)' : 'scaleX(0)';
  if (bar23) bar23.style.transform = step >= 3 ? 'scaleX(1)' : 'scaleX(0)';

  // Scroll to top of form
  window.scrollTo({ top: 0, behavior: 'smooth' });
}
</script>

<%- include('../partials/footer') %>
