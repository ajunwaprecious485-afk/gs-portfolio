<%- include('../partials/header') %>

<!-- ======================== CHECKOUT SUCCESS ======================== -->
<section class="products-section" style="padding-top: var(--space-16); padding-bottom: var(--space-20);">
  <div class="container" style="max-width: 640px; text-align: center;">

    <!-- Success Checkmark Animation -->
    <div style="margin-bottom: var(--space-8);">
      <div id="successCheckmark" style="width: 100px; height: 100px; margin: 0 auto; border-radius: var(--radius-full); background: var(--color-success-light); display: flex; align-items: center; justify-content: center; animation: scaleIn 0.5s ease forwards;">
        <svg id="checkmarkSvg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--color-success)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" style="stroke-dasharray: 60; stroke-dashoffset: 60; animation: drawCheck 0.6s 0.3s ease forwards;">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
      </div>
    </div>

    <!-- Confirmation Text -->
    <h1 style="font-size: var(--text-3xl); font-weight: var(--font-bold); color: var(--color-dark); margin-bottom: var(--space-3);">Order Confirmed!</h1>
    <p style="font-size: var(--text-lg); color: var(--color-gray-500); margin-bottom: var(--space-10); max-width: 440px; margin-left: auto; margin-right: auto;">Thank you for your purchase. We've received your order and are getting it ready.</p>

    <!-- Order Details Card -->
    <div class="card" style="padding: var(--space-8); text-align: left; margin-bottom: var(--space-8);">
      <h3 style="font-size: var(--text-lg); font-weight: var(--font-bold); color: var(--color-dark); margin-bottom: var(--space-6); padding-bottom: var(--space-4); border-bottom: 1px solid var(--color-gray-200);">Order Details</h3>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-6);">
        <!-- Order Number -->
        <div>
          <p style="font-size: var(--text-xs); font-weight: var(--font-semibold); color: var(--color-gray-400); text-transform: uppercase; letter-spacing: var(--tracking-wider); margin-bottom: var(--space-1);">Order Number</p>
          <p style="font-size: var(--text-base); font-weight: var(--font-bold); color: var(--color-dark); margin: 0;"><%= order._id.toString().slice(-8).toUpperCase() %></p>
        </div>

        <!-- Total -->
        <div>
          <p style="font-size: var(--text-xs); font-weight: var(--font-semibold); color: var(--color-gray-400); text-transform: uppercase; letter-spacing: var(--tracking-wider); margin-bottom: var(--space-1);">Total Amount</p>
          <p style="font-size: var(--text-base); font-weight: var(--font-bold); color: var(--color-primary); margin: 0;">$<%= order.total.toFixed(2) %></p>
        </div>

        <!-- Status -->
        <div>
          <p style="font-size: var(--text-xs); font-weight: var(--font-semibold); color: var(--color-gray-400); text-transform: uppercase; letter-spacing: var(--tracking-wider); margin-bottom: var(--space-1);">Status</p>
          <div style="display: inline-flex; align-items: center; gap: var(--space-2); padding: var(--space-1) var(--space-3); background: var(--color-warning-light); border-radius: var(--radius-full);">
            <div style="width: 8px; height: 8px; background: var(--color-warning); border-radius: var(--radius-full);"></div>
            <span style="font-size: var(--text-sm); font-weight: var(--font-semibold); color: #92400e;"><%= order.status || 'Pending' %></span>
          </div>
        </div>

        <!-- Payment -->
        <div>
          <p style="font-size: var(--text-xs); font-weight: var(--font-semibold); color: var(--color-gray-400); text-transform: uppercase; letter-spacing: var(--tracking-wider); margin-bottom: var(--space-1);">Payment Method</p>
          <p style="font-size: var(--text-base); font-weight: var(--font-medium); color: var(--color-dark); margin: 0;">Cash on Delivery</p>
        </div>
      </div>

      <!-- Shipping Address -->
      <% if (order.shippingAddress) { %>
        <div style="margin-top: var(--space-6); padding-top: var(--space-5); border-top: 1px solid var(--color-gray-200);">
          <p style="font-size: var(--text-xs); font-weight: var(--font-semibold); color: var(--color-gray-400); text-transform: uppercase; letter-spacing: var(--tracking-wider); margin-bottom: var(--space-2);">Shipping Address</p>
          <p style="font-size: var(--text-sm); color: var(--color-gray-700); line-height: var(--leading-relaxed); margin: 0;">
            <%= order.shippingAddress.fullName %><br>
            <%= order.shippingAddress.street %><br>
            <%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> <%= order.shippingAddress.zip %><br>
            <%= order.shippingAddress.country %>
          </p>
        </div>
      <% } %>
    </div>

    <!-- Items Ordered -->
    <% if (order.items && order.items.length > 0) { %>
      <div class="card" style="padding: var(--space-6); text-align: left; margin-bottom: var(--space-8);">
        <h4 style="font-size: var(--text-base); font-weight: var(--font-semibold); color: var(--color-dark); margin-bottom: var(--space-4);">Items Ordered</h4>
        <div style="display: flex; flex-direction: column; gap: var(--space-3);">
          <% order.items.forEach(function(item) { %>
            <div style="display: flex; gap: var(--space-3); align-items: center; padding: var(--space-3); background: var(--color-gray-50); border-radius: var(--radius-lg);">
              <% if (item.image) { %>
                <img src="<%= item.image %>" alt="<%= item.name %>" style="width: 48px; height: 48px; object-fit: cover; border-radius: var(--radius-md); border: 1px solid var(--color-gray-200); flex-shrink: 0;">
              <% } %>
              <div style="flex: 1; min-width: 0;">
                <p style="font-size: var(--text-sm); font-weight: var(--font-medium); color: var(--color-dark); margin-bottom: 2px;"><%= item.name %></p>
                <p style="font-size: var(--text-xs); color: var(--color-gray-500); margin: 0;">Qty: <%= item.quantity %></p>
              </div>
              <span style="font-size: var(--text-sm); font-weight: var(--font-semibold); color: var(--color-dark);">$<%= (item.price * item.quantity).toFixed(2) %></span>
            </div>
          <% }); %>
        </div>
      </div>
    <% } %>

    <!-- CTA -->
    <a href="/products" class="btn btn-primary btn-lg">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><polyline points="12 19 5 12 12 5"/></svg>
      Continue Shopping
    </a>
  </div>
</section>

<style>
@keyframes scaleIn {
  0% { transform: scale(0); opacity: 0; }
  60% { transform: scale(1.15); }
  100% { transform: scale(1); opacity: 1; }
}
@keyframes drawCheck {
  to { stroke-dashoffset: 0; }
}
</style>

<%- include('../partials/footer') %>
