<%- include('partials/header') %>

<style>
  .about-hero{position:relative;height:400px;display:flex;align-items:center;justify-content:center;text-align:center;background:linear-gradient(135deg,var(--color-primary) 0%,var(--color-dark) 100%);color:var(--color-white)}
  .about-hero__subtitle{font-size:var(--text-lg);color:rgba(255,255,255,0.8);max-width:560px;margin-top:var(--space-4)}
  .about-story{padding:var(--space-20) 0}
  .about-story__grid{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-12);align-items:center}
  .about-story__image{position:relative;border-radius:var(--radius-2xl);overflow:hidden;aspect-ratio:4/3}
  .about-story__image img{width:100%;height:100%;object-fit:cover}
  .about-story__image-badge{position:absolute;bottom:var(--space-6);right:var(--space-6);background:var(--color-white);color:var(--color-dark);padding:var(--space-4) var(--space-6);border-radius:var(--radius-xl);box-shadow:var(--shadow-xl)}
  .about-story__image-badge strong{display:block;font-size:var(--text-2xl);font-weight:var(--font-bold);color:var(--color-primary)}
  .about-story__image-badge span{font-size:var(--text-sm);color:var(--color-gray-500)}
  .about-values{padding:var(--space-20) 0;background:var(--color-gray-50)}
  .about-values__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-8)}
  .about-value-card{text-align:center;padding:var(--space-8) var(--space-6);background:var(--color-white);border-radius:var(--radius-xl);border:1px solid var(--color-gray-200);transition:all 0.3s}
  .about-value-card:hover{transform:translateY(-6px);box-shadow:var(--shadow-xl);border-color:transparent}
  .about-value-card__icon{width:72px;height:72px;margin:0 auto var(--space-5);display:flex;align-items:center;justify-content:center;border-radius:var(--radius-2xl);transition:all 0.3s}
  .about-value-card__icon--primary{background:var(--color-primary-50);color:var(--color-primary)}
  .about-value-card__icon--accent{background:var(--color-accent-50);color:var(--color-accent)}
  .about-value-card__icon--info{background:var(--color-info-light);color:var(--color-info)}
  .about-value-card:hover .about-value-card__icon{transform:scale(1.1)}
  .about-value-card__title{font-size:var(--text-xl);font-weight:var(--font-bold);color:var(--color-dark);margin-bottom:var(--space-3)}
  .about-value-card__desc{font-size:var(--text-base);color:var(--color-gray-500);line-height:var(--leading-relaxed)}
  .about-team{padding:var(--space-20) 0}
  .about-team__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:var(--space-8)}
  .about-team-card{text-align:center}
  .about-team-card__avatar{width:140px;height:140px;border-radius:var(--radius-full);object-fit:cover;margin:0 auto var(--space-4);border:4px solid var(--color-gray-200);transition:border-color 0.2s}
  .about-team-card:hover .about-team-card__avatar{border-color:var(--color-primary)}
  .about-team-card__name{font-size:var(--text-base);font-weight:var(--font-semibold);color:var(--color-dark);margin-bottom:var(--space-1)}
  .about-team-card__role{font-size:var(--text-sm);color:var(--color-gray-500)}
  .about-cta{position:relative;padding:var(--space-24) 0;background:linear-gradient(135deg,var(--color-primary) 0%,var(--color-dark) 100%);overflow:hidden}
  .about-cta::before{content:'';position:absolute;inset:0;background-image:url('https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?w=1600&h=900&fit=crop');background-size:cover;background-position:center;opacity:0.08}
  @media(max-width:1024px){.about-story__grid{grid-template-columns:1fr}.about-values__grid{grid-template-columns:repeat(2,1fr)}.about-team__grid{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:640px){.about-values__grid,.about-team__grid{grid-template-columns:1fr}.about-hero{height:300px}}
</style>

<!-- Hero -->
<section class="about-hero">
  <div class="container" style="position:relative;z-index:1;">
    <h1 style="color:var(--color-white);margin-bottom:var(--space-4);">About ShopEase</h1>
    <p class="about-hero__subtitle">We're on a mission to make quality products accessible to everyone, everywhere. Discover our story and what drives us forward.</p>
  </div>
</section>

<!-- Our Story -->
<section class="about-story">
  <div class="container">
    <div class="about-story__grid">
      <div class="about-story__image">
        <img src="https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?w=800&h=600&fit=crop" alt="Our Team">
        <div class="about-story__image-badge">
          <strong>Since 2024</strong>
          <span>Serving customers worldwide</span>
        </div>
      </div>
      <div>
        <span style="display:inline-block;font-size:var(--text-xs);font-weight:var(--font-bold);text-transform:uppercase;letter-spacing:var(--tracking-widest);color:var(--color-primary);margin-bottom:var(--space-3);">Our Story</span>
        <h2 style="font-size:var(--text-3xl);font-weight:var(--font-bold);color:var(--color-dark);margin-bottom:var(--space-6);">Built on Trust, Driven by Quality</h2>
        <p style="color:var(--color-gray-600);line-height:var(--leading-relaxed);margin-bottom:var(--space-4);">Founded in 2024, ShopEase started with a simple idea: everyone deserves access to quality products at fair prices. What began as a small online store has grown into a trusted marketplace serving thousands of customers worldwide.</p>
        <p style="color:var(--color-gray-600);line-height:var(--leading-relaxed);margin-bottom:var(--space-4);">We work directly with manufacturers and artisans to bring you carefully curated products that meet our high standards for quality, sustainability, and value.</p>
        <p style="color:var(--color-gray-600);line-height:var(--leading-relaxed);margin-bottom:var(--space-6);">Our team is passionate about creating the best shopping experience possible, from easy browsing to fast delivery and responsive customer support.</p>
        <div style="display:flex;gap:var(--space-4);flex-wrap:wrap;">
          <div style="text-align:center;padding:var(--space-4) var(--space-6);background:var(--color-gray-50);border-radius:var(--radius-xl);">
            <div style="font-size:var(--text-2xl);font-weight:var(--font-bold);color:var(--color-primary);">10K+</div>
            <div style="font-size:var(--text-sm);color:var(--color-gray-500);">Customers</div>
          </div>
          <div style="text-align:center;padding:var(--space-4) var(--space-6);background:var(--color-gray-50);border-radius:var(--radius-xl);">
            <div style="font-size:var(--text-2xl);font-weight:var(--font-bold);color:var(--color-primary);">500+</div>
            <div style="font-size:var(--text-sm);color:var(--color-gray-500);">Products</div>
          </div>
          <div style="text-align:center;padding:var(--space-4) var(--space-6);background:var(--color-gray-50);border-radius:var(--radius-xl);">
            <div style="font-size:var(--text-2xl);font-weight:var(--font-bold);color:var(--color-primary);">50+</div>
            <div style="font-size:var(--text-sm);color:var(--color-gray-500);">Countries</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Values -->
<section class="about-values">
  <div class="container">
    <div class="section-header">
      <span class="section-header__tag">Why Choose Us</span>
      <h2 class="section-header__title">Our Core Values</h2>
      <p class="section-header__desc">The principles that guide everything we do</p>
    </div>
    <div class="about-values__grid">
      <div class="about-value-card">
        <div class="about-value-card__icon about-value-card__icon--primary">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <h3 class="about-value-card__title">Quality First</h3>
        <p class="about-value-card__desc">Every product is carefully vetted to ensure it meets our high standards for quality, durability, and customer satisfaction.</p>
      </div>
      <div class="about-value-card">
        <div class="about-value-card__icon about-value-card__icon--accent">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
        </div>
        <h3 class="about-value-card__title">Customer Happiness</h3>
        <p class="about-value-card__desc">Your satisfaction is our top priority. Our dedicated support team is here to help with anything you need, anytime.</p>
      </div>
      <div class="about-value-card">
        <div class="about-value-card__icon about-value-card__icon--info">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
        </div>
        <h3 class="about-value-card__title">Global Reach</h3>
        <p class="about-value-card__desc">We ship to over 50 countries worldwide, bringing quality products and exceptional service to customers around the globe.</p>
      </div>
    </div>
  </div>
</section>

<!-- Team -->
<section class="about-team">
  <div class="container">
    <div class="section-header">
      <span class="section-header__tag">Our People</span>
      <h2 class="section-header__title">Meet the Team</h2>
      <p class="section-header__desc">The passionate people behind ShopEase</p>
    </div>
    <div class="about-team__grid">
      <div class="about-team-card">
        <img src="https://images.unsplash.com/photo-1560250097-0b93528c311a?w=300&h=300&fit=crop&crop=face" alt="Alex Morgan" class="about-team-card__avatar">
        <h4 class="about-team-card__name">Alex Morgan</h4>
        <p class="about-team-card__role">Founder & CEO</p>
      </div>
      <div class="about-team-card">
        <img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=300&h=300&fit=crop&crop=face" alt="Sarah Chen" class="about-team-card__avatar">
        <h4 class="about-team-card__name">Sarah Chen</h4>
        <p class="about-team-card__role">Head of Operations</p>
      </div>
      <div class="about-team-card">
        <img src="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=300&h=300&fit=crop&crop=face" alt="David Park" class="about-team-card__avatar">
        <h4 class="about-team-card__name">David Park</h4>
        <p class="about-team-card__role">Lead Developer</p>
      </div>
      <div class="about-team-card">
        <img src="https://images.unsplash.com/photo-1580489944761-15a19d654956?w=300&h=300&fit=crop&crop=face" alt="Emma Wilson" class="about-team-card__avatar">
        <h4 class="about-team-card__name">Emma Wilson</h4>
        <p class="about-team-card__role">Customer Success</p>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="about-cta">
  <div class="container" style="position:relative;z-index:1;text-align:center;">
    <h2 style="font-size:var(--text-4xl);font-weight:var(--font-extrabold);color:var(--color-white);margin-bottom:var(--space-4);">Join Our Community</h2>
    <p style="font-size:var(--text-lg);color:rgba(255,255,255,0.8);margin-bottom:var(--space-8);max-width:500px;margin-left:auto;margin-right:auto;">Over 10,000 customers trust ShopEase for their everyday needs. Be part of the story.</p>
    <div style="display:flex;gap:var(--space-4);justify-content:center;flex-wrap:wrap;">
      <a href="/products" class="btn btn-white btn-lg">Start Shopping</a>
      <a href="/contact" class="btn btn-secondary btn-lg" style="border-color:var(--color-white);color:var(--color-white);">Contact Us</a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
