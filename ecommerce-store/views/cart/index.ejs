<%- include('../partials/header') %>

<div class="page-header">
  <div class="container">
    <h1 class="page-header__title">Shopping Cart</h1>
    <p class="page-header__desc"><%= typeof cart !== 'undefined' && cart.length > 0 ? cart.length + ' item(s) in your cart' : 'Your cart is empty' %></p>
  </div>
</div>

<section class="cart-page">
  <div class="container">
    <% if (typeof cart === 'undefined' || cart.length === 0) { %>
      <div class="cart-empty">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
        <h2>Your cart is empty</h2>
        <p>Looks like you haven't added anything to your cart yet.</p>
        <a href="/products" class="btn btn-primary btn-lg">Start Shopping</a>
      </div>
    <% } else { %>
      <div class="cart-layout">
        <div class="cart-items">
          <% cart.forEach(function(item) { %>
            <div class="cart-item">
              <img src="<%= item.image %>" alt="<%= item.name %>" class="cart-item__image">
              <div class="cart-item__details">
                <span class="cart-item__category">Product</span>
                <h3 class="cart-item__name"><%= item.name %></h3>
                <span class="cart-item__price">$<%= item.price.toFixed(2) %></span>
                <div class="cart-item__actions">
                  <div class="quantity-selector">
                    <button type="button" onclick="updateCartQuantity('<%= item.productId %>', <%= item.quantity - 1 %>)">-</button>
                    <input type="number" value="<%= item.quantity %>" min="1" readonly>
                    <button type="button" onclick="updateCartQuantity('<%= item.productId %>', <%= item.quantity + 1 %>)">+</button>
                  </div>
                  <form action="/cart/remove" method="POST" style="display: inline;">
                    <input type="hidden" name="productId" value="<%= item.productId %>">
                    <button type="submit" class="cart-item__remove">Remove</button>
                  </form>
                </div>
              </div>
              <div style="text-align: right;">
                <span class="cart-item__price">$<%= (item.price * item.quantity).toFixed(2) %></span>
              </div>
            </div>
          <% }); %>
        </div>

        <div class="cart-summary">
          <h3>Order Summary</h3>
          <div class="cart-summary__row">
            <span>Subtotal</span>
            <span>$<%= subtotal.toFixed(2) %></span>
          </div>
          <div class="cart-summary__row">
            <span>Shipping</span>
            <span><%= shipping === 0 ? 'Free' : '$' + shipping.toFixed(2) %></span>
          </div>
          <div class="cart-summary__row cart-summary__total">
            <span>Total</span>
            <span>$<%= (subtotal + shipping).toFixed(2) %></span>
          </div>
          <% if (shipping === 0) { %>
            <div class="alert alert-success" style="margin-top: var(--space-4);">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              You qualify for free shipping!
            </div>
          <% } %>
          <a href="/checkout" class="btn btn-primary btn-lg">Proceed to Checkout</a>
          <a href="/products" class="btn btn-outline" style="width: 100%; margin-top: var(--space-2);">Continue Shopping</a>
        </div>
      </div>
    <% } %>
  </div>
</section>

<script>
function updateCartQuantity(productId, newQty) {
  if (newQty < 1) {
    fetch('/cart/remove', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ productId: productId })
    }).then(function() { window.location.reload(); });
    return;
  }
  fetch('/cart/update', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ productId: productId, quantity: newQty })
  }).then(function() { window.location.reload(); });
}
</script>

<%- include('../partials/footer') %>
