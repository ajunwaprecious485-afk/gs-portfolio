<%- include('../partials/header') %>

<style>
  .admin-layout{display:grid;grid-template-columns:260px 1fr;min-height:calc(100vh - var(--navbar-height))}
  .admin-sidebar{background:var(--color-dark);padding:var(--space-6);position:sticky;top:var(--navbar-height);height:calc(100vh - var(--navbar-height));overflow-y:auto;display:flex;flex-direction:column;gap:var(--space-2)}
  .admin-sidebar__brand{display:flex;align-items:center;gap:var(--space-3);padding:var(--space-4) var(--space-3);margin-bottom:var(--space-4);border-bottom:1px solid rgba(255,255,255,0.08)}
  .admin-sidebar__brand-icon{width:36px;height:36px;display:flex;align-items:center;justify-content:center;background:var(--color-primary);color:var(--color-white);border-radius:var(--radius-lg)}
  .admin-sidebar__brand-text{font-size:var(--text-lg);font-weight:var(--font-bold);color:var(--color-white)}
  .admin-sidebar__brand-text span{color:var(--color-primary-light)}
  .admin-sidebar__label{font-size:var(--text-xs);font-weight:var(--font-semibold);color:var(--color-gray-500);text-transform:uppercase;letter-spacing:var(--tracking-widest);padding:var(--space-4) var(--space-3) var(--space-2)}
  .admin-sidebar__link{display:flex;align-items:center;gap:var(--space-3);padding:var(--space-3) var(--space-4);font-size:var(--text-sm);font-weight:var(--font-medium);color:var(--color-gray-400);border-radius:var(--radius-lg);transition:all 0.2s}
  .admin-sidebar__link:hover{background:rgba(255,255,255,0.06);color:var(--color-white)}
  .admin-sidebar__link.active{background:var(--color-primary);color:var(--color-white)}
  .admin-sidebar__link svg{width:20px;height:20px;flex-shrink:0}
  .admin-content{padding:var(--space-8);background:var(--color-gray-50);overflow-y:auto}
  .admin-content__header{display:flex;justify-content:space-between;align-items:center;margin-bottom:var(--space-8)}
  .admin-content__title{font-size:var(--text-2xl);font-weight:var(--font-bold);color:var(--color-dark)}
  .admin-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:var(--space-6);margin-bottom:var(--space-8)}
  .admin-stat-card{background:var(--color-white);border-radius:var(--radius-xl);padding:var(--space-6);border:1px solid var(--color-gray-200);transition:all 0.25s;position:relative;overflow:hidden}
  .admin-stat-card:hover{transform:translateY(-3px);box-shadow:var(--shadow-lg)}
  .admin-stat-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px}
  .admin-stat-card--revenue::before{background:linear-gradient(90deg,var(--color-primary),var(--color-primary-light))}
  .admin-stat-card--orders::before{background:linear-gradient(90deg,var(--color-info),#60a5fa)}
  .admin-stat-card--products::before{background:linear-gradient(90deg,#7c3aed,#a78bfa)}
  .admin-stat-card--users::before{background:linear-gradient(90deg,var(--color-accent),#f59e0b)}
  .admin-stat-card__header{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:var(--space-4)}
  .admin-stat-card__icon{width:52px;height:52px;display:flex;align-items:center;justify-content:center;border-radius:var(--radius-xl)}
  .admin-stat-card__icon--green{background:var(--color-primary-50);color:var(--color-primary)}
  .admin-stat-card__icon--blue{background:var(--color-info-light);color:var(--color-info)}
  .admin-stat-card__icon--purple{background:#ede9fe;color:#7c3aed}
  .admin-stat-card__icon--orange{background:var(--color-accent-50);color:var(--color-accent)}
  .admin-stat-card__value{font-size:var(--text-3xl);font-weight:var(--font-bold);color:var(--color-dark);margin-bottom:var(--space-1)}
  .admin-stat-card__label{font-size:var(--text-sm);color:var(--color-gray-500)}
  .admin-actions{display:flex;gap:var(--space-3);margin-bottom:var(--space-8);flex-wrap:wrap}
  .admin-actions .btn{display:inline-flex;align-items:center;gap:var(--space-2)}
  .admin-actions .btn svg{width:16px;height:16px}
  .admin-table-card{background:var(--color-white);border-radius:var(--radius-xl);border:1px solid var(--color-gray-200);overflow:hidden}
  .admin-table-card__header{display:flex;justify-content:space-between;align-items:center;padding:var(--space-6);border-bottom:1px solid var(--color-gray-200)}
  .admin-table-card__title{font-size:var(--text-lg);font-weight:var(--font-bold);color:var(--color-dark)}
  .admin-table{width:100%;border-collapse:collapse}
  .admin-table thead{background:var(--color-gray-50)}
  .admin-table th{padding:var(--space-3) var(--space-6);font-size:var(--text-xs);font-weight:var(--font-semibold);color:var(--color-gray-500);text-transform:uppercase;letter-spacing:var(--tracking-wider);text-align:left;border-bottom:1px solid var(--color-gray-200)}
  .admin-table td{padding:var(--space-4) var(--space-6);font-size:var(--text-sm);color:var(--color-gray-700);border-bottom:1px solid var(--color-gray-100);transition:background 0.15s}
  .admin-table tbody tr:hover td{background:var(--color-gray-50)}
  .admin-table tbody tr:last-child td{border-bottom:none}
  .status-badge{display:inline-flex;align-items:center;gap:4px;padding:4px 12px;font-size:var(--text-xs);font-weight:var(--font-semibold);border-radius:var(--radius-full);text-transform:capitalize}
  .status-pending{background:var(--color-warning-light);color:#d97706}
  .status-paid{background:var(--color-info-light);color:var(--color-info)}
  .status-shipped{background:#ede9fe;color:#7c3aed}
  .status-delivered{background:var(--color-success-light);color:#16a34a}
  .status-cancelled{background:var(--color-error-light);color:var(--color-error)}
  .status-processing{background:#fef3c7;color:#92400e}
  .empty-state{text-align:center;padding:var(--space-16) var(--space-6)}
  .empty-state__icon{width:120px;height:120px;margin:0 auto var(--space-6);color:var(--color-gray-300)}
  .empty-state__title{font-size:var(--text-xl);font-weight:var(--font-bold);color:var(--color-dark);margin-bottom:var(--space-2)}
  .empty-state__desc{font-size:var(--text-base);color:var(--color-gray-500)}
  @media(max-width:1024px){.admin-layout{grid-template-columns:1fr}.admin-sidebar{display:none}.admin-stats{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:640px){.admin-stats{grid-template-columns:1fr}}
</style>

<div class="admin-layout">
  <aside class="admin-sidebar">
    <div class="admin-sidebar__brand">
      <div class="admin-sidebar__brand-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
      </div>
      <div class="admin-sidebar__brand-text">Shop<span>Ease</span></div>
    </div>
    <div class="admin-sidebar__label">Main</div>
    <a href="/admin" class="admin-sidebar__link active">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
      Dashboard
    </a>
    <a href="/admin/orders" class="admin-sidebar__link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13" rx="2"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
      Orders
    </a>
    <a href="/admin/products" class="admin-sidebar__link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
      Products
    </a>
    <div class="admin-sidebar__label">Settings</div>
    <a href="/" class="admin-sidebar__link" target="_blank">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
      View Store
    </a>
  </aside>

  <main class="admin-content">
    <div class="admin-content__header">
      <h1 class="admin-content__title">Dashboard</h1>
      <div style="font-size:var(--text-sm);color:var(--color-gray-500);">
        <%= new Date().toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
      </div>
    </div>

    <!-- Stats Grid -->
    <div class="admin-stats">
      <div class="admin-stat-card admin-stat-card--revenue">
        <div class="admin-stat-card__header">
          <div class="admin-stat-card__icon admin-stat-card__icon--green">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
          </div>
        </div>
        <div class="admin-stat-card__value">$<%= stats.revenue.toFixed(2) %></div>
        <div class="admin-stat-card__label">Total Revenue</div>
      </div>
      <div class="admin-stat-card admin-stat-card--orders">
        <div class="admin-stat-card__header">
          <div class="admin-stat-card__icon admin-stat-card__icon--blue">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13" rx="2"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          </div>
        </div>
        <div class="admin-stat-card__value"><%= stats.totalOrders %></div>
        <div class="admin-stat-card__label">Total Orders</div>
      </div>
      <div class="admin-stat-card admin-stat-card--products">
        <div class="admin-stat-card__header">
          <div class="admin-stat-card__icon admin-stat-card__icon--purple">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
          </div>
        </div>
        <div class="admin-stat-card__value"><%= stats.totalProducts %></div>
        <div class="admin-stat-card__label">Total Products</div>
      </div>
      <div class="admin-stat-card admin-stat-card--users">
        <div class="admin-stat-card__header">
          <div class="admin-stat-card__icon admin-stat-card__icon--orange">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
          </div>
        </div>
        <div class="admin-stat-card__value"><%= stats.totalUsers %></div>
        <div class="admin-stat-card__label">Total Users</div>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="admin-actions">
      <a href="/admin/products/new" class="btn btn-primary">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Add Product
      </a>
      <a href="/admin/orders" class="btn btn-secondary">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13" rx="2"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        View Orders
      </a>
      <a href="/admin/products" class="btn btn-accent">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
        View Products
      </a>
    </div>

    <!-- Recent Orders Table -->
    <div class="admin-table-card">
      <div class="admin-table-card__header">
        <h2 class="admin-table-card__title">Recent Orders</h2>
        <a href="/admin/orders" class="btn btn-sm btn-secondary">View All</a>
      </div>

      <% if (recentOrders && recentOrders.length > 0) { %>
        <table class="admin-table">
          <thead>
            <tr>
              <th>Order</th>
              <th>Customer</th>
              <th>Total</th>
              <th>Status</th>
              <th>Date</th>
            </tr>
          </thead>
          <tbody>
            <% recentOrders.forEach(function(order) { %>
              <tr>
                <td>
                  <span style="font-weight:var(--font-semibold);color:var(--color-dark);">#<%= order._id.toString().slice(-8).toUpperCase() %></span>
                </td>
                <td>
                  <div style="display:flex;align-items:center;gap:var(--space-3);">
                    <div style="width:32px;height:32px;border-radius:var(--radius-full);background:var(--color-primary-50);color:var(--color-primary);display:flex;align-items:center;justify-content:center;font-weight:var(--font-bold);font-size:var(--text-xs);flex-shrink:0;">
                      <%= order.user ? order.user.name.charAt(0).toUpperCase() : '?' %>
                    </div>
                    <span><%= order.user ? order.user.name : 'Unknown' %></span>
                  </div>
                </td>
                <td>
                  <span style="font-weight:var(--font-bold);color:var(--color-dark);">$<%= order.totalAmount.toFixed(2) %></span>
                </td>
                <td>
                  <span class="status-badge status-<%= order.status %>"><%= order.status %></span>
                </td>
                <td style="color:var(--color-gray-500);">
                  <%= order.createdAt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } else { %>
        <div class="empty-state" style="padding:var(--space-12) var(--space-6);">
          <div class="empty-state__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="1" y="3" width="15" height="13" rx="2"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
            </svg>
          </div>
          <h3 class="empty-state__title">No orders yet</h3>
          <p class="empty-state__desc">Orders will appear here once customers start making purchases.</p>
        </div>
      <% } %>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>
