<%- include('../partials/header') %>

<style>
  .admin-layout{display:grid;grid-template-columns:260px 1fr;min-height:calc(100vh - var(--navbar-height))}
  .admin-sidebar{background:var(--color-dark);padding:var(--space-6);position:sticky;top:var(--navbar-height);height:calc(100vh - var(--navbar-height));overflow-y:auto;display:flex;flex-direction:column;gap:var(--space-2)}
  .admin-sidebar__brand{display:flex;align-items:center;gap:var(--space-3);padding:var(--space-4) var(--space-3);margin-bottom:var(--space-4);border-bottom:1px solid rgba(255,255,255,0.08)}
  .admin-sidebar__brand-icon{width:36px;height:36px;display:flex;align-items:center;justify-content:center;background:var(--color-primary);color:var(--color-white);border-radius:var(--radius-lg)}
  .admin-sidebar__brand-text{font-size:var(--text-lg);font-weight:var(--font-bold);color:var(--color-white)}
  .admin-sidebar__brand-text span{color:var(--color-primary-light)}
  .admin-sidebar__label{font-size:var(--text-xs);font-weight:var(--font-semibold);color:var(--color-gray-500);text-transform:uppercase;letter-spacing:var(--tracking-widest);padding:var(--space-4) var(--space-3) var(--space-2)}
  .admin-sidebar__link{display:flex;align-items:center;gap:var(--space-3);padding:var(--space-3) var(--space-4);font-size:var(--text-sm);font-weight:var(--font-medium);color:var(--color-gray-400);border-radius:var(--radius-lg);transition:all 0.2s}
  .admin-sidebar__link:hover{background:rgba(255,255,255,0.06);color:var(--color-white)}
  .admin-sidebar__link.active{background:var(--color-primary);color:var(--color-white)}
  .admin-sidebar__link svg{width:20px;height:20px;flex-shrink:0}
  .admin-content{padding:var(--space-8);background:var(--color-gray-50);overflow-y:auto}
  .admin-content__header{display:flex;justify-content:space-between;align-items:center;margin-bottom:var(--space-8)}
  .admin-content__title{font-size:var(--text-2xl);font-weight:var(--font-bold);color:var(--color-dark)}
  .admin-table-card{background:var(--color-white);border-radius:var(--radius-xl);border:1px solid var(--color-gray-200);overflow:hidden}
  .admin-table{width:100%;border-collapse:collapse}
  .admin-table thead{background:var(--color-gray-50)}
  .admin-table th{padding:var(--space-3) var(--space-6);font-size:var(--text-xs);font-weight:var(--font-semibold);color:var(--color-gray-500);text-transform:uppercase;letter-spacing:var(--tracking-wider);text-align:left;border-bottom:1px solid var(--color-gray-200)}
  .admin-table td{padding:var(--space-4) var(--space-6);font-size:var(--text-sm);color:var(--color-gray-700);border-bottom:1px solid var(--color-gray-100);transition:background 0.15s;vertical-align:middle}
  .admin-table tbody tr:hover td{background:var(--color-gray-50)}
  .admin-table tbody tr:last-child td{border-bottom:none}
  .product-cell{display:flex;align-items:center;gap:var(--space-3)}
  .product-cell__img{width:44px;height:44px;border-radius:var(--radius-lg);object-fit:cover;background:var(--color-gray-100);flex-shrink:0}
  .stock-badge{display:inline-flex;align-items:center;padding:3px 10px;font-size:var(--text-xs);font-weight:var(--font-semibold);border-radius:var(--radius-full)}
  .stock-badge--out{background:var(--color-error-light);color:var(--color-error)}
  .stock-badge--low{background:var(--color-warning-light);color:#d97706}
  .stock-badge--ok{background:var(--color-success-light);color:#16a34a}
  .featured-badge{display:inline-flex;align-items:center;gap:4px;padding:3px 10px;font-size:var(--text-xs);font-weight:var(--font-semibold);border-radius:var(--radius-full);background:var(--color-accent-50);color:var(--color-accent)}
  .action-btns{display:flex;gap:var(--space-2)}
  .action-btn{width:34px;height:34px;display:inline-flex;align-items:center;justify-content:center;border-radius:var(--radius-md);transition:all 0.15s}
  .action-btn--edit{background:var(--color-info-light);color:var(--color-info)}
  .action-btn--edit:hover{background:var(--color-info);color:var(--color-white)}
  .action-btn--delete{background:var(--color-error-light);color:var(--color-error)}
  .action-btn--delete:hover{background:var(--color-error);color:var(--color-white)}
  .action-btn svg{width:16px;height:16px}
  .empty-state{text-align:center;padding:var(--space-16) var(--space-6)}
  .empty-state__icon{width:120px;height:120px;margin:0 auto var(--space-6);color:var(--color-gray-300)}
  .empty-state__title{font-size:var(--text-xl);font-weight:var(--font-bold);color:var(--color-dark);margin-bottom:var(--space-2)}
  .empty-state__desc{font-size:var(--text-base);color:var(--color-gray-500);margin-bottom:var(--space-6)}
  @media(max-width:1024px){.admin-layout{grid-template-columns:1fr}.admin-sidebar{display:none}}
  @media(max-width:768px){.admin-table th:nth-child(4),.admin-table td:nth-child(4),.admin-table th:nth-child(5),.admin-table td:nth-child(5){display:none}}
</style>

<div class="admin-layout">
  <aside class="admin-sidebar">
    <div class="admin-sidebar__brand">
      <div class="admin-sidebar__brand-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
      </div>
      <div class="admin-sidebar__brand-text">Shop<span>Ease</span></div>
    </div>
    <div class="admin-sidebar__label">Main</div>
    <a href="/admin" class="admin-sidebar__link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
      Dashboard
    </a>
    <a href="/admin/orders" class="admin-sidebar__link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13" rx="2"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
      Orders
    </a>
    <a href="/admin/products" class="admin-sidebar__link active">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
      Products
    </a>
    <div class="admin-sidebar__label">Settings</div>
    <a href="/" class="admin-sidebar__link" target="_blank">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
      View Store
    </a>
  </aside>

  <main class="admin-content">
    <div class="admin-content__header">
      <h1 class="admin-content__title">Products</h1>
      <a href="/admin/products/new" class="btn btn-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Add Product
      </a>
    </div>

    <div class="admin-table-card">
      <% if (typeof products !== 'undefined' && products.length > 0) { %>
        <table class="admin-table">
          <thead>
            <tr>
              <th>Product</th>
              <th>Name</th>
              <th>Price</th>
              <th>Category</th>
              <th>Stock</th>
              <th>Featured</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% products.forEach(function(product) { %>
              <tr>
                <td>
                  <div class="product-cell">
                    <img src="<%= product.image %>" alt="<%= product.name %>" class="product-cell__img">
                  </div>
                </td>
                <td>
                  <span style="font-weight:var(--font-semibold);color:var(--color-dark);"><%= product.name %></span>
                </td>
                <td>
                  <span style="font-weight:var(--font-bold);color:var(--color-dark);">$<%= product.price.toFixed(2) %></span>
                </td>
                <td>
                  <span style="text-transform:capitalize;color:var(--color-gray-500);"><%= product.category %></span>
                </td>
                <td>
                  <% if (product.stock === 0) { %>
                    <span class="stock-badge stock-badge--out">Out of Stock</span>
                  <% } else if (product.stock < 5) { %>
                    <span class="stock-badge stock-badge--low"><%= product.stock %> left</span>
                  <% } else { %>
                    <span class="stock-badge stock-badge--ok"><%= product.stock %> in stock</span>
                  <% } %>
                </td>
                <td>
                  <% if (product.featured) { %>
                    <span class="featured-badge">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                      Featured
                    </span>
                  <% } else { %>
                    <span style="color:var(--color-gray-400);font-size:var(--text-xs);">-</span>
                  <% } %>
                </td>
                <td>
                  <div class="action-btns">
                    <a href="/admin/products/<%= product._id %>/edit" class="action-btn action-btn--edit" title="Edit">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                    </a>
                    <form action="/admin/products/<%= product._id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this product?')">
                      <button type="submit" class="action-btn action-btn--delete" title="Delete">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } else { %>
        <div class="empty-state">
          <div class="empty-state__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/>
            </svg>
          </div>
          <h3 class="empty-state__title">No products yet</h3>
          <p class="empty-state__desc">Get started by adding your first product to the store.</p>
          <a href="/admin/products/new" class="btn btn-primary">Add Your First Product</a>
        </div>
      <% } %>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>
