<%- include('../partials/header') %>

<div class="page-header">
  <div class="container">
    <a href="/products" style="font-size: var(--text-sm); color: var(--color-primary); display: inline-flex; align-items: center; gap: var(--space-1); margin-bottom: var(--space-4);">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
      Back to Products
    </a>
    <h1 class="page-header__title"><%= product.name %></h1>
  </div>
</div>

<section class="product-detail">
  <div class="container">
    <div class="product-detail__grid">
      <div class="product-detail__images">
        <div class="product-detail__main-image">
          <img src="<%= product.image %>" alt="<%= product.name %>">
        </div>
      </div>

      <div>
        <span class="product-detail__category"><%= product.category %></span>
        <h1 class="product-detail__title"><%= product.name %></h1>

        <div class="product-detail__rating">
          <div class="product-detail__stars">
            <% for (var i = 1; i <= 5; i++) { %>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="<%= i <= Math.round(product.rating) ? 'var(--color-accent)' : 'var(--color-gray-200)' %>"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <% } %>
          </div>
          <span style="font-size: var(--text-sm); color: var(--color-gray-500);"><%= product.rating %> (<%= product.numReviews || 0 %> reviews)</span>
        </div>

        <div class="product-detail__price">
          <span class="product-detail__current-price">$<%= product.price.toFixed(2) %></span>
          <% if (product.comparePrice && product.comparePrice > product.price) { %>
            <span class="product-detail__compare-price">$<%= product.comparePrice.toFixed(2) %></span>
            <span class="badge badge-sale">Save <%= Math.round((1 - product.price / product.comparePrice) * 100) %>%</span>
          <% } %>
        </div>

        <p class="product-detail__description"><%= product.description || product.shortDescription || '' %></p>

        <div class="product-detail__stock">
          <% if (product.stock > 0) { %>
            <span class="product-detail__stock-badge product-detail__stock-badge--in">In Stock</span>
            <span style="color: var(--color-gray-500); font-size: var(--text-sm);"><%= product.stock %> available</span>
          <% } else { %>
            <span class="product-detail__stock-badge product-detail__stock-badge--out">Out of Stock</span>
          <% } %>
        </div>

        <% if (product.stock > 0) { %>
          <form action="/cart/add" method="POST" class="js-add-to-cart add-to-cart-form">
            <input type="hidden" name="productId" value="<%= product._id %>">
            <div class="quantity-selector">
              <button type="button" onclick="var inp=this.nextElementSibling; inp.value=Math.max(1,parseInt(inp.value)-1);">-</button>
              <input type="number" name="quantity" value="1" min="1" max="<%= product.stock %>">
              <button type="button" onclick="var inp=this.previousElementSibling; inp.value=Math.min(<%= product.stock %>,parseInt(inp.value)+1);">+</button>
            </div>
            <button type="submit" class="btn btn-primary btn-lg">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
              Add to Cart
            </button>
          </form>
        <% } %>

        <% if (typeof product.brand !== 'undefined' && product.brand) { %>
          <p style="margin-top: var(--space-6); font-size: var(--text-sm); color: var(--color-gray-500);">
            <strong>Brand:</strong> <%= product.brand %>
          </p>
        <% } %>
        <% if (typeof product.sku !== 'undefined' && product.sku) { %>
          <p style="font-size: var(--text-sm); color: var(--color-gray-500);">
            <strong>SKU:</strong> <%= product.sku %>
          </p>
        <% } %>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
